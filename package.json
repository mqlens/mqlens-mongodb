{
  "name": "mqlens",
  "private": true,
  "version": "0.21.0",
  "description": "A native desktop GUI for MongoDB, built with Tauri and React.",
  "homepage": "https://mqlens.com",
  "author": "Devesh Kumar <vrshu112@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli extract --ci --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:merge-coverage": "esbuild e2e/coverage-setup/merge-shards.ts --bundle --platform=node --format=esm --packages=external --outfile=coverage/merge-shards.mjs --log-level=warning && node coverage/merge-shards.mjs",
    "check:tauri-versions": "node scripts/check-tauri-versions.js",
    "coverage:frontend": "vitest run --coverage",
    "coverage:backend": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --summary-only --ignore-filename-regex 'src-tauri/src/((lib|main)\\.rs|server/pb/)'",
    "coverage": "npm run coverage:frontend && npm run coverage:backend",
    "media:capture": "playwright test --config playwright.media.config.ts",
    "test:website": "playwright test --config playwright.website.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "bson": "^7.3.3",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.5.5",
    "lucide-react": "^1.61.0",
    "monaco-editor": "0.57.0",
    "mongodb-query-parser": "^5.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.2",
    "react-resizable-panels": "^4.14.8",
    "react-window": "^2.5.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^2.0.0",
    "@typescript/typescript6": "~6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "0.28.2",
    "i18next-cli": "^1.80.0",
    "jsdom": "^30.1.3",
    "monocart-coverage-reports": "3.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "undici": "7.30.1",
    "@babel/core": "7.29.7",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "nanoid": "3.3.20"
  }
}
