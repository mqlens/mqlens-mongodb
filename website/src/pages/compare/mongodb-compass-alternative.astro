---
import WorkflowLanding from "../../components/WorkflowLanding.astro";
const content = {
  "title": "MongoDB Compass alternative for MongoDB — MQLens",
  "description": "Considering a MongoDB Compass alternative? Compare MQLens workflows, setup, privacy, and limitations, with links to the official product information.",
  "eyebrow": "Choosing a MongoDB workspace",
  "h1": "Considering an alternative to MongoDB Compass?",
  "grad": "Start with your workflow.",
  "lede": "MongoDB Compass is the official MongoDB GUI. It offers document exploration, queries, aggregation pipelines, schema analysis, and visual explain plans. MQLens is another free desktop option, with an open-source workspace and locally encrypted connection settings.",
  "screenshot": {
    "src": "/screenshots/mqlens-workspace.png",
    "alt": "MQLens workspace with sample data in two collection panes"
  },
  "stepsTitle": "Evaluate MQLens with a real task",
  "steps": [
    {
      "title": "Connect to a test database",
      "body": "Set up your connection and check authentication, TLS, and SSH requirements before moving any production work."
    },
    {
      "title": "Run a familiar query",
      "body": "Browse the result, build an aggregation, and inspect an explain plan. Compare usability with the tool you already know."
    },
    {
      "title": "Check your requirements",
      "body": "If you want the GUI built by MongoDB, start with Compass. If an Apache-2.0 workspace with split panes and optional MCP access fits your workflow, try MQLens against a test database."
    }
  ],
  "featuresTitle": "Make an informed choice",
  "features": [
    {
      "h3": "What MQLens offers",
      "p": "A free Apache-2.0 desktop app, encrypted local credentials, split panes, document editing, aggregation pipelines, and explain plans. See the <a href=\"/features/\">complete feature list</a>."
    },
    {
      "h3": "Choose the workflow that fits",
      "p": "If you want the GUI built by MongoDB, start with Compass. If an Apache-2.0 workspace with split panes and optional MCP access fits your workflow, try MQLens against a test database."
    },
    {
      "h3": "Sources and scope",
      "p": "Product information reviewed on October 4, 2026. See the <a href=\"https://www.mongodb.com/products/tools/compass\">official MongoDB Compass website</a> for current features and license terms."
    }
  ]
};
---
<WorkflowLanding {...content} />
