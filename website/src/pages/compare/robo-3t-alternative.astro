---
import WorkflowLanding from "../../components/WorkflowLanding.astro";
const content = {
  "title": "Robo 3T alternative for MongoDB — MQLens",
  "description": "Considering a Robo 3T alternative? Compare MQLens workflows, setup, privacy, and limitations, with links to the official product information.",
  "eyebrow": "Choosing a MongoDB workspace",
  "h1": "Considering an alternative to Robo 3T?",
  "grad": "Start with your workflow.",
  "lede": "Looking for a new workspace after using Robo 3T? MQLens combines a document browser, aggregation editor, explain plans, and an optional mongosh shell. The former Robo 3T website now points visitors to Studio 3T Community Edition.",
  "screenshot": {
    "src": "/screenshots/mqlens-workspace.png",
    "alt": "MQLens workspace with synthetic data in two collection panes"
  },
  "stepsTitle": "Evaluate MQLens with a real task",
  "steps": [
    {
      "title": "Connect to a test database",
      "body": "Set up your connection and check authentication, TLS, and SSH requirements before moving any production work."
    },
    {
      "title": "Run a familiar query",
      "body": "Browse the result, build an aggregation, and inspect an explain plan. Compare usability with the tool you already know."
    },
    {
      "title": "Check your requirements",
      "body": "Start with a test database and recreate the connection settings in MQLens. Check your authentication, TLS and SSH setup, then validate your saved queries. Automatic import of Robo 3T connection profiles is not advertised."
    }
  ],
  "featuresTitle": "Make an informed choice",
  "features": [
    {
      "h3": "What MQLens offers",
      "p": "A free Apache-2.0 desktop app, encrypted local credentials, split panes, document editing, aggregation pipelines, and explain plans. See the <a href=\"/features/\">complete feature list</a>."
    },
    {
      "h3": "Move one connection at a time",
      "p": "Start with a test database and recreate the connection settings in MQLens. Check your authentication, TLS and SSH setup, then validate your saved queries. Automatic import of Robo 3T connection profiles is not advertised."
    },
    {
      "h3": "Sources and scope",
      "p": "Product information reviewed on October 4, 2026. See the <a href=\"https://robomongo.org/\">official Robo 3T website</a> for current features and license terms. This page is maintained by MQLens; it does not claim benchmark superiority or complete feature parity."
    }
  ]
};
---
<WorkflowLanding {...content} />
