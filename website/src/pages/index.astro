---
import BaseLayout from '../layouts/BaseLayout.astro';
import Download from '../components/Download.astro';
import { SITE } from '../consts';
const workflows = [
  { id: 'explore', label: 'Explore your data', title: 'From a collection to a clear picture.', body: 'Browse documents as a table, tree, or JSON. Follow nested fields, filter your results, and edit without losing your place.', image: 'documents', alt: 'MQLens document workspace showing sample customer records', link: '/features/#documents', cta: 'Explore the document tools' },
  { id: 'query', label: 'Build better queries', title: 'Write the query. Understand the result.', body: 'Build aggregation pipelines one stage at a time. Open an explain plan to inspect how MongoDB executes your query and where an index could help.', image: 'aggregation', alt: 'MQLens aggregation pipeline editor with stages and query results', link: '/guides/mongodb-aggregation-gui/', cta: 'Build your first aggregation' },
  { id: 'workspace', label: 'Make room for your work', title: 'A workspace that works your way.', body: 'Keep collections side by side with split panes. Open a shell, detach a tab into another window, and return to your saved workspace next time.', image: 'workspace', alt: 'MQLens workspace with two collection panes side by side', link: '/features/#workspace', cta: 'See workspace features' },
];
const gallery = [
  { image: 'explain-plan', title: 'Understand an explain plan', link: '/mongodb-explain-plan-gui/', alt: 'Query plan stages and execution details in MQLens' },
  { image: 'schema', title: 'Explore your document structure', link: '/mongodb-schema-analysis-tool/', alt: 'MQLens schema report with field types and presence' },
  { image: 'gridfs', title: 'Keep files close to your data', link: '/mongodb-gridfs-gui/', alt: 'MQLens GridFS browser with sample files' },
];
---
<BaseLayout>
  <section class="home-hero">
    <div class="container">
      <div class="hero-top">
        <div>
          <p class="product-line"><span class="status-dot" aria-hidden="true"></span> Your MongoDB desktop workspace</p>
          <h1>Browse, query, and<br class="desktop-break" /> understand MongoDB.</h1>
        </div>
        <div class="hero-intro">
          <p>Get from a database full of documents to the answer you need. A free, open-source app for macOS, Windows, and Linux.</p>
          <div class="actions">
            <a class="btn btn-primary" href="#download">Download MQLens</a>
            <a class="btn btn-ghost" href="/demo/">Watch the demo</a>
          </div>
          <p class="hero-fine">No account. No app telemetry. Yours to inspect.</p>
        </div>
      </div>
      <figure class="hero-preview">
        <div class="preview-bar"><span>MQLens workspace</span><a href="/demo/">See it in action <span aria-hidden="true">↗</span></a></div>
        <a href="/screenshots/mqlens-workspace.png" aria-label="Open full-size MQLens workspace screenshot">
          <picture><source media="(max-width: 640px)" srcset="/screenshots/mqlens-workspace-mobile.webp" width="640" height="500" /><img src="/screenshots/mqlens-workspace.webp" alt="Current MQLens interface with two collections open side by side using sample data" width="1600" height="1000" fetchpriority="high" /></picture>
        </a>
        <figcaption>One workspace. Your collections, queries, and tools together. <span>Interface preview with sample data.</span></figcaption>
      </figure>
      <div class="principles" aria-label="Why MQLens">
        <div><strong>Free, all the way through.</strong><span>Apache-2.0. Read the source, make it yours.</span></div>
        <div><strong>Your credentials stay encrypted.</strong><span>A local vault, protected by your master password.</span></div>
        <div><strong>Connect on your terms.</strong><span>Local or remote MongoDB, with SSH and TLS.</span></div>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="section-intro"><p class="section-label">From the everyday to the intricate</p><h2>Less switching.<br />More understanding.</h2><p>Follow your work from the first query to the final result.</p></div>
      <div class="home-workflows">
        {workflows.map(w => <article class="workflow" id={w.id}>
          <div class="workflow-copy"><p class="section-label">{w.label}</p><h3>{w.title}</h3><p>{w.body}</p><a class="text-link" href={w.link}>{w.cta}</a></div>
          <a class="workflow-image" href={`/screenshots/mqlens-${w.image}.png`} aria-label={`Open full-size screenshot: ${w.title}`}><img src={`/screenshots/mqlens-${w.image}.webp`} alt={w.alt} width="1600" height="1000" loading="lazy" decoding="async" /></a>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section agent-section">
    <div class="container agent-grid">
      <div><p class="section-label">Optional AI, with explicit controls</p><h2>A little help with<br />the next query.</h2><p>Ask the query assistant for MQL, then review and edit its response. Or connect an MCP-compatible agent to the databases you explicitly allow.</p><p class="muted">AI is optional. External providers receive the context needed for your request; check your provider and connection settings before using sensitive data.</p><div class="actions"><a class="text-link" href="/mongodb-ai-query-assistant/">Query assistant</a><a class="text-link" href="/mongodb-mcp-server/">MCP for agents</a></div></div>
      <a class="workflow-image" href="/screenshots/mqlens-ai-assistant.png"><img src="/screenshots/mqlens-ai-assistant.webp" alt="MQLens AI query assistant with a sample query draft" width="1600" height="1000" loading="lazy" /></a>
    </div>
  </section>

  <section class="section" id="gallery">
    <div class="container"><div class="section-intro"><p class="section-label">A closer look</p><h2>Tools for the next question.</h2><p>Explore the tools with sample data, then open a workflow to learn more.</p></div>
      <div class="gallery-grid">{gallery.map(s => <a class="gallery-item" href={s.link}><img src={`/screenshots/mqlens-${s.image}.webp`} alt={s.alt} width="1600" height="1000" loading="lazy" /><h3>{s.title}</h3></a>)}</div>
    </div>
  </section>

  <section class="section getting-started"><div class="container"><div class="section-intro"><p class="section-label">Your first query is close</p><h2>Download. Connect. Explore.</h2></div><ol class="steps-grid"><li><h3>Install MQLens</h3><p>Choose your platform below. Open the app and set up your local credential vault.</p></li><li><h3>Add your database</h3><p>Use a MongoDB connection string. Configure SSH, TLS, and authentication when you need them.</p></li><li><h3>Open a collection</h3><p>Browse the documents, write a filter, and run your first query. Or start with the built-in sample data.</p></li></ol><a class="text-link" href="/docs/">Read the getting-started guide</a></div></section>

  <section class="section" id="download"><div class="container"><div class="section-intro"><p class="section-label">Ready when you are</p><h2>Your next MongoDB workspace.</h2><p>Choose the installer for your computer. Free and open source, with no sign-up.</p></div><Download /></div></section>

  <section class="section faq-section"><div class="container faq-grid"><div><p class="section-label">Good questions</p><h2>Before you connect.</h2><p>See the <a href="/docs/#security">security model</a> or <a href={SITE.repo}>inspect the source</a>.</p></div><div class="faq-list">
    <details><summary>Is MQLens free?</summary><p>Yes. MQLens is free and open source under the Apache-2.0 license. You can download it without an account. Optional external AI providers may charge for API usage.</p></details>
    <details><summary>Can I connect to MongoDB Atlas or a local database?</summary><p>MQLens accepts MongoDB connection strings for local and remote deployments. Your network access and database permissions still apply. SSH tunnels, TLS, and several authentication methods are available.</p></details>
    <details><summary>Does MQLens collect telemetry?</summary><p>The desktop app does not collect telemetry. Connection credentials are encrypted locally. Requests to your MongoDB deployment and optional AI providers are part of the workflows you choose to use.</p></details>
    <details><summary>What safeguards are available for production?</summary><p>You can mark connections read-only or require confirmation for destructive operations. These controls help reduce accidental changes; use appropriate MongoDB permissions and backups as well.</p></details>
    <details><summary>Do I need mongosh or an AI key?</summary><p>Neither is needed to browse or query through the GUI. The embedded shell requires a mongosh installation. The optional query assistant needs a configured provider or supported local agent CLI.</p></details>
  </div></div></section>
  <section class="closing"><div class="container"><h2>Your data has a story.<br />Get a clearer view.</h2><a class="btn btn-primary" href="#download">Download MQLens</a><a class="text-link" href={SITE.repo}>Explore the source on GitHub</a></div></section>
</BaseLayout>
<style>
  .home-hero { padding: 76px 0 0; }
  .hero-top { display:grid; grid-template-columns:1.25fr 1fr; gap:60px; align-items:end; margin-bottom:44px; }
  .product-line,.section-label { font-size:.9rem; font-weight:600; color:var(--accent); margin:0 0 18px; }
  .product-line { display:flex; align-items:center; gap:10px; }
  .status-dot { width:8px; height:8px; border-radius:50%; background:var(--accent); }
  h1 { font-size:clamp(2.7rem,4.8vw,4.35rem); line-height:1.05; letter-spacing:-.055em; margin:0; }
  .hero-intro > p:first-child { font-size:1.12rem; line-height:1.65; margin:0 0 23px; color:var(--text-dim); }
  .actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px 24px; }
  .hero-fine { font-size:.8rem; color:var(--text-dim); margin:16px 0 0; }
  .hero-preview { margin:0; border:1px solid var(--border); border-radius:12px; overflow:hidden; background:white; box-shadow:0 20px 60px #17243b0c; }
  .preview-bar { display:flex; justify-content:space-between; padding:13px 20px; font-size:.8rem; font-weight:600; }
  .hero-preview img { display:block; width:100%; height:auto; }
  figcaption { padding:14px 20px; font-size:.8rem; color:var(--text-dim); } figcaption span { float:right; }
  .principles { display:grid; grid-template-columns:repeat(3,1fr); padding:32px 0; gap:32px; border-bottom:1px solid var(--border); }
  .principles strong,.principles span { display:block; font-size:.9rem; } .principles span { color:var(--text-dim); margin-top:5px; }
  .section-intro { max-width:650px; margin-bottom:48px; }
  h2 { font-size:clamp(2rem,3.8vw,3.1rem); letter-spacing:-.04em; margin:0 0 20px; }
  .section-intro > p:last-child,.workflow-copy > p:not(.section-label),.agent-grid p,.steps-grid p { color:var(--text-dim); }
  .home-workflows { display:grid; gap:80px; }
  .workflow { display:grid; grid-template-columns:.85fr 1.4fr; gap:64px; align-items:center; }
  .workflow-copy h3 { font-size:clamp(1.6rem,2.6vw,2.15rem); letter-spacing:-.035em; margin:0 0 18px; }
  .workflow-copy > p { margin-bottom:24px; }
  .workflow-image { display:block; overflow:hidden; border-radius:8px; border:1px solid var(--border); }
  .workflow-image img { display:block; width:100%; height:auto; }
  .agent-section { background:var(--bg-soft); border-block:1px solid var(--border); }
  .agent-grid { display:grid; grid-template-columns:1fr 1.1fr; gap:64px; align-items:center; }
  .muted { font-size:.85rem; }
  .gallery-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  .gallery-item { color:var(--text); } .gallery-item img { width:100%; height:auto; border-radius:6px; border:1px solid var(--border); }
  .gallery-item h3 { font-size:1rem; margin:18px 0 0; }
  .getting-started { background:white; border-block:1px solid var(--border); }
  .steps-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:48px; padding:0; counter-reset:steps; list-style:none; margin:0 0 28px; }
  .steps-grid li { counter-increment:steps; }
  .steps-grid li::before { content:counter(steps); display:block; color:var(--accent); font-size:1.7rem; margin-bottom:12px; }
  .steps-grid h3 { font-size:1.1rem; }
  .faq-grid { display:grid; grid-template-columns:1fr 1.35fr; gap:80px; }
  .faq-list details { border-bottom:1px solid var(--border); padding:20px 0; } .faq-list details:first-child { border-top:1px solid var(--border); }
  summary { cursor:pointer; font-weight:600; } .faq-list p { color:var(--text-dim); margin:16px 0 0; }
  .closing { padding:72px 0; background:#e6eff8; } .closing .text-link { margin-left:24px; }
  @media(max-width:900px) { .hero-top { grid-template-columns:1fr; gap:24px; }.hero-intro { max-width:620px; }.workflow,.agent-grid { gap:32px; }.faq-grid { gap:32px; } }
  @media(max-width:640px) { .home-hero { padding-top:40px; }.desktop-break { display:none; }.hero-top { margin-bottom:28px; }.principles,.workflow,.agent-grid,.gallery-grid,.steps-grid,.faq-grid { grid-template-columns:1fr; }.principles { gap:20px; }.home-workflows { gap:48px; }.section-intro { margin-bottom:28px; }.gallery-grid { gap:32px; }.steps-grid { gap:20px; }figcaption span { float:none; display:block; margin-top:4px; }.closing .text-link { display:block; margin:20px 0 0; }.hero-preview figcaption { padding:12px; }.preview-bar { padding:12px; } }
</style>
