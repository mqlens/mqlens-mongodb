---
import WorkflowLanding from '../components/WorkflowLanding.astro';
---
<WorkflowLanding title="Free MongoDB GUI for Linux" description="Download MQLens for Linux. A free MongoDB desktop GUI with .deb, .rpm, and AppImage packages, document browsing, aggregation pipelines, and explain plans."
  eyebrow="MQLens for Linux" h1="Your MongoDB workspace." grad="On Linux."
  lede="MQLens is a free, open-source MongoDB GUI for Linux. Browse and edit documents, build aggregation pipelines, inspect explain plans, and manage connection settings in one desktop workspace. Choose the current package for your distribution from the download section below."
  screenshot={{ src: '/screenshots/mqlens-documents.png', alt: 'MQLens document workspace with synthetic sample data' }}
  stepsTitle="Install the package for your system" steps={[
    { title: 'Debian or Ubuntu', body: 'Download the .deb and install it with your package manager, for example <code>sudo apt install ./MQLens_*.deb</code>. Review the release notes for current system requirements.' },
    { title: 'Fedora or RPM distributions', body: 'Download the .rpm and use your distribution’s package manager. Check architecture and dependency requirements before installing.' },
    { title: 'AppImage', body: 'Find the AppImage in the release assets, make it executable with <code>chmod +x MQLens_*.AppImage</code>, then run it. Required system libraries vary by distribution.' },
  ]}
  featuresTitle="A complete everyday workflow" features={[
    { h3: 'Explore and query', p: 'View documents as a table, tree, or JSON. Build queries and aggregation pipelines in the same workspace.' },
    { h3: 'Connect securely', p: 'Use MongoDB connection strings, TLS, and SSH tunnels. Credentials are encrypted locally behind your master password.' },
    { h3: 'Use the shell when you need it', p: 'The optional embedded shell requires mongosh on your system. You can browse and run GUI queries without it.' },
  ]} />
