---
import { SITE } from '../consts';
const year = new Date().getUTCFullYear();
---

<footer class="footer">
  <div class="container foot-inner">
    <div class="foot-brand">
      <div class="brand-row">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        <strong>{SITE.name}</strong>
      </div>
      <p>{SITE.tagline}.</p>
    </div>
    <div class="foot-cols">
      <div>
        <h3>Product</h3>
        <a href="/#features">Features</a>
        <a href="/#download">Download</a>
        <a href="/changelog/">Changelog</a>
        <a href="/demo/">Watch the demo</a>
        <a href="/mqlens-server/">Server · Coming soon</a>
        <a href="/mongodb-client-for-mac/">macOS</a>
        <a href="/mongodb-client-for-windows/">Windows</a>
        <a href="/mongodb-gui-for-linux/">Linux</a>
      </div>
      <div>
        <h3>Resources</h3>
        <a href="/docs/">Getting started</a>
        <a href="/docs/#verifying">Verify downloads</a>
        <a href="/docs/#security">Security</a>
        <a href={SITE.repo} target="_blank" rel="noopener">GitHub</a>
        <a href={SITE.releases} target="_blank" rel="noopener">Releases</a>
        <a href={`${SITE.repo}/issues`} target="_blank" rel="noopener">Issues</a>
      </div>
      <div>
        <h3>Compare</h3>
        <a href="/compare/mongodb-compass-alternative/">vs MongoDB Compass</a>
        <a href="/compare/studio-3t-alternative/">vs Studio 3T</a>
        <a href="/compare/robo-3t-alternative/">vs Robo 3T</a>
        <a href="/compare/nosqlbooster-alternative/">vs NoSQLBooster</a>
      </div>
      <div>
        <h3>Workflows</h3>
        <a href="/mongodb-ssh-tunnel-gui/">SSH tunnel</a>
        <a href="/mongodb-explain-plan-gui/">Explain plans</a>
        <a href="/mongodb-aggregation-pipeline-gui/">Aggregation pipelines</a>
        <a href="/mongodb-schema-analysis-tool/">Schema analysis</a>
        <a href="/mongodb-gridfs-gui/">GridFS browser</a>
        <a href="/mongodb-gui-no-telemetry/">No telemetry</a>
        <a href="/mongodb-mcp-server/">MongoDB MCP server</a>
        <a href="/mongodb-ai-query-assistant/">AI query assistant</a>
      </div>
    </div>
  </div>
  <div class="container foot-bottom">
    <span>© {year} {SITE.name}. Desktop app licensed under {SITE.license}.</span>
    <span>Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding: 36px 0 24px;
    margin-top: 40px;
  }
  .foot-inner {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 32px;
  }
  .foot-brand { max-width: 280px; }
  .brand-row { display: flex; align-items: center; gap: 8px; font-size: 1.1rem; }
  .foot-brand p { color: var(--text-dim); margin: 10px 0 0; }
  .foot-cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .foot-cols > div { min-width: 0; }
  .foot-cols h3 {
    font-size: 0.8rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-dim);
    margin: 0 0 12px;
  }
  .foot-cols a { display: block; color: var(--text); margin-bottom: 8px; font-size: 0.92rem; }
  .foot-cols a:hover { color: var(--accent-bright); text-decoration: none; }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  @media (max-width: 1050px) {
    .foot-inner { grid-template-columns: 1fr; gap: 24px; }
    .foot-brand { max-width: none; }
  }
  @media (max-width: 600px) {
    .foot-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
    .foot-cols a { overflow-wrap: anywhere; }
  }
</style>
